{
  "info": {
    "_postman_id": "fitnexus-backend-api-v1",
    "name": "FitNexus Fitness Tracker REST API",
    "description": "Production Postman Collection for Aptech eProject Demonstration. Includes complete Authentication, User Profile, Workout Management, Nutrition Tracking, Fitness Goals, Schedules, Body Progress, Notifications, Aggregated Dashboard, and Reports.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health & Server Status",
      "item": [
        {
          "name": "API Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Authentication",
      "item": [
        {
          "name": "Register Athlete",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Jordan Hayes\",\n  \"email\": \"jordan.hayes@fitnexus.io\",\n  \"password\": \"password123\",\n  \"confirmPassword\": \"password123\",\n  \"gender\": \"Male\",\n  \"dateOfBirth\": \"1995-08-20\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (Demo Athlete)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('authToken', json.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rivera@fitnexus.io\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current Athlete Profile (/api/auth/me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Forgot Password Request",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alex.rivera@fitnexus.io\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"resetToken\": \"<PASTE_RESET_TOKEN_HERE>\",\n  \"password\": \"newpassword123\",\n  \"confirmPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset-password"]
            }
          }
        },
        {
          "name": "Logout Athlete",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "3. User Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Rivera\",\n  \"height\": 180,\n  \"weight\": 74.0,\n  \"bio\": \"Focused on functional conditioning and progressive overload.\",\n  \"preferences\": {\n    \"theme\": \"dark\",\n    \"weightUnit\": \"kg\",\n    \"accentColor\": \"#16B8B0\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Workouts",
      "item": [
        {
          "name": "Get All Workouts (Search & Filters)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/workouts?category=Upper Body&search=Press",
              "host": ["{{baseUrl}}"],
              "path": ["workouts"],
              "query": [
                { "key": "category", "value": "Upper Body" },
                { "key": "search", "value": "Press" }
              ]
            }
          }
        },
        {
          "name": "Create Workout Log",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workoutName\": \"Evening Back & Bi Blast\",\n  \"exerciseName\": \"Barbell Bent-Over Row\",\n  \"category\": \"Gym\",\n  \"sets\": 4,\n  \"reps\": 10,\n  \"weight\": 75,\n  \"duration\": 45,\n  \"notes\": \"Strict back angle, paused at chest contraction.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["workouts"]
            }
          }
        },
        {
          "name": "Get Workout By ID",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/workouts/<WORKOUT_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["workouts", "<WORKOUT_ID>"]
            }
          }
        },
        {
          "name": "Update Workout",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 80,\n  \"reps\": 12,\n  \"notes\": \"Progressed load to 80kg seamlessly.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workouts/<WORKOUT_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["workouts", "<WORKOUT_ID>"]
            }
          }
        },
        {
          "name": "Delete Workout",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/workouts/<WORKOUT_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["workouts", "<WORKOUT_ID>"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Nutrition",
      "item": [
        {
          "name": "Get All Logged Meals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition"]
            }
          }
        },
        {
          "name": "Get Daily Nutrition Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/summary?date=2026-11-09",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "summary"],
              "query": [{ "key": "date", "value": "2026-11-09" }]
            }
          }
        },
        {
          "name": "Log New Meal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodName\": \"Grass-fed Sirloin Steak with Sweet Potato\",\n  \"mealType\": \"Dinner\",\n  \"quantity\": \"1 plate (250g)\",\n  \"calories\": 620,\n  \"protein\": 54,\n  \"carbohydrates\": 45,\n  \"fats\": 18\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/nutrition",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition"]
            }
          }
        },
        {
          "name": "Update Meal",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"calories\": 650,\n  \"protein\": 58\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/nutrition/<MEAL_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "<MEAL_ID>"]
            }
          }
        },
        {
          "name": "Delete Meal",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/nutrition/<MEAL_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["nutrition", "<MEAL_ID>"]
            }
          }
        }
      ]
    },
    {
      "name": "6. Fitness Goals",
      "item": [
        {
          "name": "Get All Goals",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/goals",
              "host": ["{{baseUrl}}"],
              "path": ["goals"]
            }
          }
        },
        {
          "name": "Create Goal",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Barbell Bench Press 100kg PR\",\n  \"category\": \"Strength\",\n  \"targetValue\": 100,\n  \"currentValue\": 85,\n  \"unit\": \"kg\",\n  \"deadline\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/goals",
              "host": ["{{baseUrl}}"],
              "path": ["goals"]
            }
          }
        },
        {
          "name": "Update Goal Progress",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentValue\": 92,\n  \"notes\": \"Hit 92kg for 2 clean paused reps.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/goals/<GOAL_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["goals", "<GOAL_ID>"]
            }
          }
        },
        {
          "name": "Delete Goal",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/goals/<GOAL_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["goals", "<GOAL_ID>"]
            }
          }
        }
      ]
    },
    {
      "name": "7. Workout Schedule",
      "item": [
        {
          "name": "Get Schedules (Date/Month Filter)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedules?month=2026-11",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"],
              "query": [{ "key": "month", "value": "2026-11" }]
            }
          }
        },
        {
          "name": "Schedule Activity",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Plyometric HIIT Circuit\",\n  \"activityType\": \"Cardio\",\n  \"category\": \"Cardio\",\n  \"date\": \"2026-11-12\",\n  \"time\": \"06:30 AM\",\n  \"duration\": \"40 min\",\n  \"notes\": \"Box jumps, burpees, and battle ropes.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules",
              "host": ["{{baseUrl}}"],
              "path": ["schedules"]
            }
          }
        },
        {
          "name": "Toggle Schedule Complete",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"completed\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/schedules/<SCHEDULE_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "<SCHEDULE_ID>"]
            }
          }
        },
        {
          "name": "Delete Scheduled Activity",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/schedules/<SCHEDULE_ID>",
              "host": ["{{baseUrl}}"],
              "path": ["schedules", "<SCHEDULE_ID>"]
            }
          }
        }
      ]
    },
    {
      "name": "8. Progress Tracking",
      "item": [
        {
          "name": "Get Progress Records (Chronological)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["progress"]
            }
          }
        },
        {
          "name": "Get Progress Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/progress/summary",
              "host": ["{{baseUrl}}"],
              "path": ["progress", "summary"]
            }
          }
        },
        {
          "name": "Record Body Progress",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"weight\": 74.2,\n  \"chest\": 105.2,\n  \"waist\": 81.0,\n  \"hips\": 94.8,\n  \"arms\": 38.2,\n  \"bodyFat\": 14.5,\n  \"notes\": \"Lowest waist circumference this quarter.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/progress",
              "host": ["{{baseUrl}}"],
              "path": ["progress"]
            }
          }
        }
      ]
    },
    {
      "name": "9. Notifications",
      "item": [
        {
          "name": "Get Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            }
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "unread-count"]
            }
          }
        },
        {
          "name": "Mark All As Read",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "read-all"]
            }
          }
        }
      ]
    },
    {
      "name": "10. Dashboard API",
      "item": [
        {
          "name": "Get Aggregated Dashboard Data",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["dashboard"]
            }
          }
        }
      ]
    },
    {
      "name": "11. Performance Reports",
      "item": [
        {
          "name": "Fitness Performance Report",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/fitness?range=30days",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "fitness"],
              "query": [{ "key": "range", "value": "30days" }]
            }
          }
        },
        {
          "name": "Nutrition Performance Report",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/nutrition?range=30days",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "nutrition"],
              "query": [{ "key": "range", "value": "30days" }]
            }
          }
        },
        {
          "name": "Export Workouts CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/export/workouts",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export", "workouts"]
            }
          }
        },
        {
          "name": "Export Nutrition CSV",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/reports/export/nutrition",
              "host": ["{{baseUrl}}"],
              "path": ["reports", "export", "nutrition"]
            }
          }
        }
      ]
    }
  ]
}
