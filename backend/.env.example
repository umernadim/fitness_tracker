# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/fitnexus?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fitnexus

# JWT Authentication Secret & Expiration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=30d

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173
